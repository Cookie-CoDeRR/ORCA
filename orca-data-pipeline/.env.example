# ==============================================================================
# PROJECT ORCA (SIH26176) — DATA PIPELINE CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Pipeline Execution Mode
# ------------------------------------------------------------------------------
# Set to 'true' to force offline/synthetic generation of NetCDF and ERDDAP data.
# Set to 'false' to query live Copernicus Marine, INCOIS, and Marine Regions APIs.
ORCA_PIPELINE_MOCK_MODE=false

# ------------------------------------------------------------------------------
# 2. Spatial Bounding Box (Default: Indian Maritime Exclusive Economic Zone & Seas)
# ------------------------------------------------------------------------------
# Bounding Box Coordinates: [min_lon, min_lat, max_lon, max_lat] in WGS84 (EPSG:4326)
ORCA_BBOX_MIN_LON=65.0
ORCA_BBOX_MIN_LAT=5.0
ORCA_BBOX_MAX_LON=90.0
ORCA_BBOX_MAX_LAT=25.0

# Temporal Range for Downloads (in days relative to today, e.g. 3 for past 3 days)
ORCA_TEMPORAL_DAYS_LOOKBACK=3

# ------------------------------------------------------------------------------
# 3. Copernicus Marine Service API (CMEMS)
# ------------------------------------------------------------------------------
# Register for free credentials at: https://marine.copernicus.eu/
COPERNICUS_USERNAME=riteshjagdale.work@gmail.com
COPERNICUS_PASSWORD=Nanapatil@123

# Copernicus Dataset IDs
# Global Ocean Physics Analysis and Forecast (SST, Currents)
COPERNICUS_PHYSICS_DATASET_ID=cmems_mod_glo_phy-cur_anfc_0.083deg_P1D-m
# Global Ocean Biogeochemistry Analysis and Forecast (Chlorophyll-a)
COPERNICUS_BGC_DATASET_ID=cmems_mod_glo_bgc-bio_anfc_0.25deg_P1D-m

# ------------------------------------------------------------------------------
# 4. INCOIS ERDDAP & MOSDAC Configuration
# ------------------------------------------------------------------------------
# INCOIS ERDDAP Server Endpoint: https://erddap.incois.gov.in/erddap/
INCOIS_ERDDAP_BASE_URL=https://erddap.incois.gov.in/erddap
INCOIS_PFZ_DATASET_ID=pfz_advisory_latest
INCOIS_WAVE_DATASET_ID=incois_swh_forecast_india

# ------------------------------------------------------------------------------
# 5. Marine Regions / Global Boundary Sources
# ------------------------------------------------------------------------------
MARINE_REGIONS_EEZ_WFS_URL=https://geo.vliz.be/geoserver/MarineRegions/wfs

# ------------------------------------------------------------------------------
# 6. Output Storage & COG Compression
# ------------------------------------------------------------------------------
COG_TILE_SIZE=256
COG_COMPRESSION=DEFLATE
COG_OVERVIEW_RESAMPLING=bilinear
